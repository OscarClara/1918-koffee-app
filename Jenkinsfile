    agent any

    stages {
        stage('Construcción') {
            steps {
                echo 'Preparando los contenedores de 1918 Koffee... 🔨'
            }
        }
        stage('Pruebas') {
            steps {
                echo 'Probando el código como café especial... ☕'
            }
        }
        stage('Despliegue') {
            steps {
                echo 'Desplegando en el puerto 3000... 🚀'
            }
        }
    }
}